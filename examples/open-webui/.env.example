# Copy to .env and fill in. Never commit .env.
#
# Generate VOIDLLM_ENCRYPTION_KEY, VOIDLLM_ADMIN_KEY and WEBUI_SECRET_KEY with:
#   openssl rand -base64 32

# Required. AES-256-GCM key for secrets VoidLLM stores in its DB.
# Keep it stable: changing it makes stored upstream keys unreadable.
VOIDLLM_ENCRYPTION_KEY=

# First start only (min 32 chars). Triggers the bootstrap of the first
# system admin. The real admin API key (vl_uk_...) is printed once to the
# container log: docker compose logs voidllm
VOIDLLM_ADMIN_KEY=

# Team key (vl_tk_...) that Open WebUI uses to talk to VoidLLM.
# Create it first (README step 4), then start open-webui. Open WebUI reads
# this only on its first start; later changes go through its Admin Settings.
OPENAI_API_KEY=

# Required. Open WebUI session signing key. Keep it stable: if it is unset,
# Open WebUI generates one inside the container (not in its data volume) and
# every container recreate logs all users out.
WEBUI_SECRET_KEY=
